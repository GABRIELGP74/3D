function formatMoney(value){ const n=Number(value ?? 0); return money.format(Number.isFinite(n)?n:0); }
function formatDate(date){ return new Intl.DateTimeFormat('pt-BR', { day: '2-digit', month: 'short', year: 'numeric' }).format(new Date(`${date}T12:00:00`)).replace('.', ''); }
function getProduct(id){ return state.products.find(p => p.id === id); }
function getFilament(id){ return state.filaments.find(f => f.id === id); }
function filamentCost(id){ const f = getFilament(id); return f ? f.price / f.initial : 0; }
function productionFilamentsOf(p){ return Array.isArray(p.filaments) && p.filaments.length ? p.filaments : (p.filamentId ? [{filamentId:p.filamentId, grams:Number(p.grams)||0}] : []); }
function productionGramsOf(p){ return productionFilamentsOf(p).reduce((a,x)=>a+Number(x.grams||0),0); }
