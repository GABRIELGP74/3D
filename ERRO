    const producedGood=state.productions.filter(p=>p.status==='concluída').reduce((sum,p)=>sum+(Number(p.qty)||0),0);
    const producedFailures=state.productions.filter(p=>p.status!=='concluída').reduce((sum,p)=>sum+(Number(p.qty)||0),0);
    const sold=confirmed.reduce((sum,s)=>sum+(Number(s.qty)||0),0);
    const stock=state.products.reduce((sum,p)=>sum+(Number(p.stock)||0),0);
    const productionMinutes=state.productions.reduce((sum,p)=>sum+(Number(p.minutes)||0),0)+state.personal.reduce((sum,u)=>sum+(Number(u.minutes)||0),0);
    const low=state.filaments.filter(f=>(Number(f.current)||0)<=(Number(f.minimum)||0));
    return {...totals,filamentInvestment,printerInvestment,equipmentInvestment,hardwareInvestment,totalInvestment,target,remaining:Math.max(0,target-totals.profit),percent:target?Math.max(0,Math.min(100,totals.profit/target*100)):0,personalCost,personalMarket,personalSaving:personalMarket-personalCost,producedGood,producedFailures,sold,stock,productionMinutes,low};
  };

  /* Mantém o payback histórico e corrige a dependência do relógio fixo. */
