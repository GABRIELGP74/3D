function productCost(product){ if(!product) return 0; if(product.cost !== undefined && product.cost !== null) return Number(product.cost); return product.grams * filamentCost(product.filamentId) + Number(product.packaging || 0) + Number(product.other || 0); }
function productHours(product){ return product && product.minutes ? product.minutes / 60 : 0; }
function saleTotals(sale){
  const product = getProduct(sale.productId);
  const qty = Number(sale.qty)||0;
  const unitPrice = Number(sale.price)||0;
  const gross = qty * unitPrice;
  const discount = gross * (Number(sale.discount)||0) / 100;
  const netRevenue = Math.max(0, gross - discount);
  const commission = netRevenue * (Number(sale.commission)||0) / 100;
  const productionCost = productCost(product) * qty;
  const totalCost = productionCost + commission;
  const profit = netRevenue - totalCost;
  return { gross, discount, netRevenue, commission, productionCost, totalCost, cost: totalCost, profit, unitCost: productCost(product), product };
}
function allCalculations(){
  const confirmed = state.sales.filter(s => s.status === 'pago');
  const revenues = confirmed.reduce((sum, s) => sum + saleTotals(s).netRevenue, 0);
  const salesCost = confirmed.reduce((sum, s) => sum + saleTotals(s).totalCost, 0);
  const profit = confirmed.reduce((sum, s) => sum + saleTotals(s).profit, 0);
  const filamentInvestment = state.filaments.reduce((sum, f) => sum + Number(f.price), 0);
  const printerInvestment = Number(state.printer.value || 0);
  const equipmentInvestment = (Array.isArray(state.equipment) ? state.equipment : []).reduce((sum, e) => sum + Number(e.value || 0), 0);
  const hardwareInvestment = printerInvestment + equipmentInvestment;
  const totalInvestment = hardwareInvestment + filamentInvestment + Number(state.otherInvestments || 0);
  const target = state.target === 'printer' ? hardwareInvestment : state.target === 'printer-filaments' ? hardwareInvestment + filamentInvestment : totalInvestment;
  const personalCost = state.personal.reduce((sum, u) => sum + u.grams * filamentCost(u.filamentId), 0);
  const personalMarket = state.personal.reduce((sum, u) => sum + Number(u.marketValue || 0), 0);
  const producedGood = state.productions.filter(p => p.status === 'concluída').reduce((sum, p) => sum + Number(p.qty), 0);
  const producedFailures = state.productions.filter(p => p.status !== 'concluída').reduce((sum, p) => sum + Number(p.qty), 0);
  const sold = confirmed.reduce((sum, s) => sum + Number(s.qty), 0);
  const stock = state.products.reduce((sum, p) => sum + Number(p.stock), 0);
  const productionMinutes = state.productions.reduce((sum, p) => sum + Number(p.minutes || 0), 0) + state.personal.reduce((sum,u)=>sum+Number(u.minutes||0),0);
  const low = state.filaments.filter(f => Number(f.current) <= Number(f.minimum));
  return { revenues, salesCost, profit, filamentInvestment, printerInvestment, equipmentInvestment, hardwareInvestment, totalInvestment, target, remaining: Math.max(0, target - profit), percent: target ? Math.min(100, profit / target * 100) : 0, personalCost, personalMarket, personalSaving: personalMarket-personalCost, producedGood, producedFailures, sold, stock, productionMinutes, low };
}
function visibleProductStats(){
  return state.products.map(product => {
    const sales = state.sales.filter(s => s.productId === product.id && s.status === 'pago');
    const revenue = sales.reduce((a,s)=>a+saleTotals(s).gross,0);
