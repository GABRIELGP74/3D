      save(); renderAll(); closeModal(); showToast('Produto e estoque salvos com sucesso.');
    } catch (error) { console.error('Falha ao salvar produto:', error); showToast('Não foi possível salvar o produto. Tente novamente.'); }
  }, true);
  const priorRenderAll = renderAll;
  renderAll = function () { priorRenderAll(); requestAnimationFrame(renderInteractiveDashboard); };
  setTimeout(() => { if (document.body.classList.contains('authenticated')) renderInteractiveDashboard(); }, 80);
})();
</script>
<script>
/* Progresso visual do investimento e calculadora de custo por peça. */
(function () {
  const safeNumber = input => Number.isFinite(Number(input)) ? Number(input) : 0;
  const inputValue = id => safeNumber(document.getElementById(id)?.value);
  function refreshInvestmentVisuals() {
    const summary = allCalculations();
    const percent = Math.max(0, Math.min(100, safeNumber(summary.percent)));
    const ring = document.querySelector('.ring');
    if (ring) {
      ring.style.background = `conic-gradient(from -90deg, #4ee18d 0deg ${percent * 3.6}deg, #243128 ${percent * 3.6}deg 360deg)`;
      ring.style.transition = 'background .55s ease';
      ring.setAttribute('aria-label', `${Math.round(percent)}% do investimento recuperado`);
    }
    const hero = document.getElementById('hero-payback'); if (hero) hero.textContent = `${Math.round(percent)}%`;
    const progress = document.getElementById('payback-progress'); if (progress) progress.style.width = `${percent}%`;
    const paid = (state.sales || []).filter(sale => sale.status === 'pago').slice().sort((a, b) => String(a.date).localeCompare(String(b.date)));
    let running = 0; const history = [0];
    paid.forEach(sale => { running += safeNumber(saleTotals(sale).profit); history.push(Math.max(0, running)); });
    const target = Math.max(1, safeNumber(summary.target));
    const daily = paid.length > 1 ? Math.max(0, running / Math.max(1, paid.length * 7)) : Math.max(0, running / 30);
    const values = history.slice(-5);
    while (values.length < 5) values.unshift(0);
    values.push(Math.min(target, values[values.length - 1] + daily * 14));
    const maximum = Math.max(target, ...values, 1);
    const points = values.map((amount, index) => `${index * 30},${57 - (amount / maximum) * 52}`).join(' ');
    const spark = document.querySelector('.spark');
    if (spark) spark.innerHTML = `<svg viewBox="0 0 150 60" preserveAspectRatio="none" role="img" aria-label="Projeção de recuperação do investimento"><path d="M ${points}" fill="none" stroke="#4ee18d" stroke-width="2.4" stroke-linecap="round" stroke-linejoin="round"/><circle cx="150" cy="${57 - (values[values.length - 1] / maximum) * 52}" r="3" fill="#4ee18d"/></svg>`;
  }
  function refreshQuickCalculator() {
    try {
      const pieces = Math.max(1, Math.floor(inputValue('calc-pieces-tray') || 1));
      const material = inputValue('calc-filament-kg') / 1000 * inputValue('calc-grams-piece');
      const energy = (inputValue('calc-power-piece') / 1000) * inputValue('calc-hours-piece') * inputValue('calc-energy-piece');
      const machine = inputValue('calc-machine-hour') * inputValue('calc-hours-piece');
      const labor = inputValue('calc-finish-hours') * inputValue('calc-hourly-rate');
      const extrasTotal = inputValue('calc-extras-piece') * pieces;
      const subtotal = material + energy + machine + labor + extrasTotal;
      const wasteRate = Math.max(0, Math.min(0.5, inputValue('calc-waste-rate') / 100));
      const batchTotal = wasteRate < 1 ? subtotal / (1 - wasteRate) : subtotal;
      const wasteAmount = batchTotal - subtotal;
      const unitCost = batchTotal / pieces;
      const margin = Math.max(0, Math.min(0.95, inputValue('calc-margin-rate') / 100));
      const suggestedPrice = margin < 1 ? unitCost / (1 - margin) : unitCost;
      const plannedProfit = inputValue('calc-sale-price') - unitCost;
      const update = (id, amount) => {
        const output = document.getElementById(id);
        if (output) output.textContent = formatMoney(amount);
      };
      update('calc-material-result', material);
      update('calc-energy-result', energy);
      update('calc-machine-result', machine);
      update('calc-labor-result', labor);
      update('calc-extras-result', extrasTotal);
      update('calc-waste-result', wasteAmount);
      update('calc-batch-total-result', batchTotal);
      update('calc-total-piece-result', unitCost);
      update('calc-suggested-price', suggestedPrice);
      update('calc-profit-result', plannedProfit);
      const profit = document.getElementById('calc-profit-result');
      if (profit) profit.style.color = plannedProfit >= 0 ? 'var(--green)' : 'var(--red)';
    } catch (err) {
      console.error('Calculadora:', err);
    }
  }
  function bindCalculatorEvents() {
    const root = document.querySelector('.quick-calculator');
    if (!root || root.dataset.calcBound === '1') return;
    root.dataset.calcBound = '1';
    root.addEventListener('input', refreshQuickCalculator);
    root.addEventListener('change', refreshQuickCalculator);
    root.addEventListener('keyup', refreshQuickCalculator);
  }
  document.addEventListener('input', event => { if (event.target.closest('.quick-calculator')) refreshQuickCalculator(); });
  document.addEventListener('change', event => { if (event.target.closest('.quick-calculator')) refreshQuickCalculator(); });
  const lastRenderAll = renderAll;
  renderAll = function () {
    lastRenderAll();
    requestAnimationFrame(() => {
      refreshInvestmentVisuals();
      bindCalculatorEvents();
      refreshQuickCalculator();
    });
  };
  // Recalcula ao abrir a página de uso pessoal / calculadora
  document.addEventListener('click', event => {
    const nav = event.target.closest('[data-page="calculator"]');
    if (nav) setTimeout(refreshQuickCalculator, 50);
  });
  setTimeout(() => {
    bindCalculatorEvents();
    refreshInvestmentVisuals();
    refreshQuickCalculator();
  }, 150);
})();
</script>
</html>
