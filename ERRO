function svgLine(values, target){
  const w=600,h=184,pad=10;
  const max=Math.max(Number(target)||0,...values,1)*1.08;
  const pts=values.map((v,i)=>{
    const x=values.length<=1?w/2:i*(w/(values.length-1));
    const y=h-pad-(Math.max(0,Number(v)||0)/max)*(h-pad*2);
    return [x,y];
  });
  const d=pts.map((p,i)=>(i?'L':'M')+p[0].toFixed(1)+','+p[1].toFixed(1)).join(' ');
  return {d, area:d+' L '+w+','+h+' L 0,'+h+' Z', last:pts[pts.length-1], max};
}
