(function(){
  const originalProductCost=productCost;
  function correctedSaleTotals(sale){
    const product=getProduct(sale.productId);
    const qty=Number(sale.qty)||0;
    const price=Number(sale.price)||0;
    const gross=qty*price;
    const discount=Math.max(0,gross*(Number(sale.discount)||0)/100);
    const afterDiscount=Math.max(0,gross-discount);
    const commission=Math.max(0,afterDiscount*(Number(sale.commission)||0)/100);
    const productionCost=Math.max(0,originalProductCost(product))*qty;
    const totalCost=productionCost+commission;
    const netRevenue=afterDiscount;
    const profit=netRevenue-totalCost;
    return {gross,discount,commission,productionCost,totalCost,netRevenue,cost:totalCost,profit,unitCost:product?originalProductCost(product):0,product};
  }
  saleTotals=correctedSaleTotals;

  allCalculations=function(){
    const confirmed=state.sales.filter(s=>s.status==='pago');
    const totals=confirmed.reduce((a,s)=>{const t=correctedSaleTotals(s);a.revenues+=t.netRevenue;a.salesCost+=t.totalCost;a.profit+=t.profit;return a;},{revenues:0,salesCost:0,profit:0});
    const filamentInvestment=state.filaments.reduce((sum,f)=>sum+(Number(f.price)||0),0);
