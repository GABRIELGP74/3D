<script>
/* ===== PATCH FINAL 3 — salvamento de vendas realmente isolado da renderização ===== */
(function(){
  const previousSubmitData = submitData;
  submitData = async function(form){
    const key = String(form?.dataset?.kind || '').trim();
    if(key !== 'sale') return previousSubmitData(form);

    let sale = null, product = null, customer = null, stockChanged = false;
    try {
      const d = inputData(form);
      const productId = String(d.productId || '').trim();
      product = getProduct(productId);
      if(!product) return showToast('Selecione um produto válido antes de salvar a venda.');

      const qty = Number(d.qty);
      const price = Number(d.price);
      const discount = Number(d.discount || 0);
      const commission = Number(d.commission || 0);
      if(!Number.isFinite(qty) || qty <= 0) return showToast('Informe uma quantidade válida.');
      if(!Number.isFinite(price) || price < 0) return showToast('Informe um preço válido.');
      if(!Number.isFinite(discount) || discount < 0 || discount > 100) return showToast('O desconto deve ficar entre 0% e 100%.');
      if(!Number.isFinite(commission) || commission < 0 || commission > 100) return showToast('A comissão/taxa deve ficar entre 0% e 100%.');

      const status = String(d.status || 'pago');
      if(status === 'pago' && Number(product.stock || 0) < qty){
        return showToast(`Estoque insuficiente: ${Number(product.stock||0)} unidade(s) disponíveis.`);
      }

      // Primeiro cria o registro. Foto é opcional e nunca pode impedir o salvamento.
      let photo='';
      try { photo = await fileToDataUrl(d.photo); } catch(photoError) { console.warn('Foto ignorada:', photoError); }
      sale = {
        id:`s${Date.now()}-${Math.random().toString(36).slice(2,7)}`,
        productId, qty, channel:String(d.channel||'Outro'), price, discount, commission,
        customer:String(d.customer||'').trim(), date:d.date || today,
        payment:String(d.payment||'PIX'), status, photo, notes:String(d.notes||'').trim()
      };
      if(!Array.isArray(state.sales)) state.sales=[];
      state.sales.push(sale);

      if(status === 'pago'){ product.stock = Number(product.stock||0) - qty; stockChanged=true; }

      // Cliente é atualização secundária; nunca deve impedir a venda.
      const customerName = sale.customer.toLowerCase();
      if(customerName && Array.isArray(state.customers)){
        customer = state.customers.find(c=>String(c.name||'').trim().toLowerCase()===customerName) || null;
        if(customer){
          customer.purchases = Number(customer.purchases||0) + 1;
          let revenue = qty * price;
          revenue = Math.max(0, revenue - Math.max(0,revenue*discount/100));
          customer.spent = Number(customer.spent||0) + revenue;
        }
      }

      // ESTE é o ponto crítico: salvar antes de renderizar qualquer gráfico/tela.
      try {
        save();
      } catch(saveError) {
        // Se a foto lotar o localStorage, tenta novamente sem a foto.
        if(sale.photo){
          sale.photo='';
          try { save(); } catch(secondError) {
            state.sales = state.sales.filter(x=>x.id!==sale.id);
            if(stockChanged) product.stock = Number(product.stock||0) + qty;
            if(customer){ customer.purchases=Math.max(0,Number(customer.purchases||0)-1); }
            throw secondError;
          }
          console.warn('Venda salva sem foto por limite de armazenamento.');
        } else {
          throw saveError;
        }
      }

      // A venda JÁ está salva. Se algum gráfico/tela der erro, não pode dizer que a venda falhou.
      try { renderAll(); } catch(renderError) {
        console.error('Venda salva, mas houve erro ao atualizar a interface:', renderError);
      }
      try { closeModal(); } catch(e) {}
      showToast(status === 'pago' ? 'Venda salva com sucesso e estoque atualizado.' : 'Venda salva com sucesso.');
    } catch(error){
      console.error('ERRO REAL AO SALVAR VENDA:', error);
      // Somente aqui informamos falha de salvamento.
      showToast('Erro ao salvar a venda. Nenhum dado foi perdido.');
    }
  };
})();
</script>

<script>
/* Motor estável de indicadores: um único cálculo financeiro e gráficos que
   respondem imediatamente a cada alteração nos registros. */
(function () {
  const asNumber = value => {
    const number = Number(value);
    return Number.isFinite(number) ? number : 0;
  };

  /* Uma meta personalizada é um valor, não uma das três opções predefinidas. */
  allCalculations = function () {
    const confirmed = (state.sales || []).filter(s => s.status === 'pago');
    const totals = confirmed.reduce((result, sale) => {
      const item = saleTotals(sale);
      result.revenues += asNumber(item.netRevenue);
      result.salesCost += asNumber(item.totalCost);
      result.profit += asNumber(item.profit);
      return result;
    }, { revenues: 0, salesCost: 0, profit: 0 });
    const filamentInvestment = (state.filaments || []).reduce((sum, item) => sum + asNumber(item.price), 0);
    const printerInvestment = asNumber(state.printer && state.printer.value);
    const equipmentInvestment = (state.equipment || []).reduce((sum, item) => sum + asNumber(item.value), 0);
    const hardwareInvestment = printerInvestment + equipmentInvestment;
    const totalInvestment = hardwareInvestment + filamentInvestment + asNumber(state.otherInvestments);
    const configuredTarget = asNumber(state.target);
    const target = state.target === 'printer' ? hardwareInvestment
      : state.target === 'printer-filaments' ? hardwareInvestment + filamentInvestment
      : state.target === 'everything' ? totalInvestment
      : configuredTarget > 0 ? configuredTarget : totalInvestment;
    const personalCost = (state.personal || []).reduce((sum, item) => sum + asNumber(item.grams) * filamentCost(item.filamentId), 0);
    const personalMarket = (state.personal || []).reduce((sum, item) => sum + asNumber(item.marketValue), 0);
    const producedGood = (state.productions || []).filter(item => item.status === 'concluída').reduce((sum, item) => sum + asNumber(item.qty), 0);
    const producedFailures = (state.productions || []).filter(item => item.status !== 'concluída').reduce((sum, item) => sum + asNumber(item.qty), 0);
    const sold = confirmed.reduce((sum, item) => sum + asNumber(item.qty), 0);
    const stock = (state.products || []).reduce((sum, item) => sum + asNumber(item.stock), 0);
    const productionMinutes = (state.productions || []).reduce((sum, item) => sum + asNumber(item.minutes), 0) + (state.personal || []).reduce((sum, item) => sum + asNumber(item.minutes), 0);
    const low = (state.filaments || []).filter(item => asNumber(item.current) <= asNumber(item.minimum));
    const remaining = Math.max(0, target - totals.profit);
    return { ...totals, filamentInvestment, printerInvestment, equipmentInvestment, hardwareInvestment, totalInvestment, target, remaining, percent: target ? Math.max(0, Math.min(100, totals.profit / target * 100)) : 0, personalCost, personalMarket, personalSaving: personalMarket - personalCost, producedGood, producedFailures, sold, stock, productionMinutes, low };
  };

  renderSettings = function () {
    const values = allCalculations();
    const printer = $('#target-printer'), printerFilaments = $('#target-printer-filaments'), everything = $('#target-everything');
    if (printer) printer.textContent = formatMoney(values.printerInvestment);
    if (printerFilaments) printerFilaments.textContent = formatMoney(values.printerInvestment + values.filamentInvestment);
    if (everything) everything.textContent = formatMoney(values.totalInvestment);
    const selected = [...document.querySelectorAll('#payback-target input')].find(input => input.value === String(state.target));
    if (selected) selected.checked = true;
  };

  function pointDate(value) {
    const date = new Date(`${value}T12:00:00`);
    return Number.isNaN(date.getTime()) ? new Date() : date;
  }
  function shortDate(value) {
    return pointDate(value).toLocaleDateString('pt-BR', { day: '2-digit', month: 'short' }).replace('.', '');
  }
  function svg(tag, attributes, contents) {
    const attrs = Object.entries(attributes || {}).map(([key, value]) => `${key}="${String(value).replaceAll('&', '&amp;').replaceAll('"', '&quot;')}"`).join(' ');
    return `<${tag}${attrs ? ` ${attrs}` : ''}>${contents || ''}</${tag}>`;
  }
  function tooltip(container) {
    let node = container.querySelector('.live-chart-tooltip');
    if (!node) {
      node = document.createElement('div');
      node.className = 'live-chart-tooltip';
      node.style.cssText = 'position:absolute;z-index:3;display:none;pointer-events:none;background:#111c15;border:1px solid #3d7953;color:#e9f6ee;border-radius:6px;padding:7px 9px;font-size:10px;line-height:1.45;box-shadow:0 8px 24px rgba(0,0,0,.35)';
      container.style.position = 'relative';
      container.append(node);
    }
    return node;
  }
  function bindHover(container) {
    const hint = tooltip(container);
    container.onpointermove = event => {
      const target = event.target.closest('[data-tip]');
      if (!target || !container.contains(target)) { hint.style.display = 'none'; return; }
      hint.innerHTML = target.dataset.tip;
      hint.style.display = 'block';
      hint.style.left = `${Math.min(container.clientWidth - hint.offsetWidth - 6, Math.max(6, event.offsetX + 12))}px`;
      hint.style.top = `${Math.max(6, event.offsetY - hint.offsetHeight - 10)}px`;
    };
    container.onpointerleave = () => { hint.style.display = 'none'; };
  }
  function setSvg(container, content, label) {
    if (!container) return;
    container.innerHTML = `<svg viewBox="0 0 760 250" preserveAspectRatio="none" role="img" aria-label="${label}" style="width:100%;height:100%;display:block;overflow:visible">${content}</svg>`;
    bindHover(container);
  }
  function safeRange() {
    const range = reportRange === '3m' ? 90 : reportRange === '7d' ? 7 : 30;
    const newest = (state.sales || []).reduce((latest, sale) => Math.max(latest, pointDate(sale.date).getTime()), Date.now());
    const end = new Date(Math.max(Date.now(), newest)); end.setHours(12, 0, 0, 0);
    const start = new Date(end); start.setDate(start.getDate() - range + 1); start.setHours(12, 0, 0, 0);
    return { range, start, end };
  }
  function bucketsForPeriod() {
    const { range, start, end } = safeRange();
    const count = range === 7 ? 7 : range === 30 ? 6 : 9;
    const size = range / count;
    const buckets = Array.from({ length: count }, (_, index) => {
      const date = new Date(start); date.setDate(start.getDate() + Math.floor(index * size));
      return { date, revenue: 0, cost: 0, profit: 0 };
    });
    (state.sales || []).filter(item => item.status === 'pago').forEach(sale => {
      const date = pointDate(sale.date);
      if (date < start || date > end) return;
      const index = Math.min(count - 1, Math.max(0, Math.floor(((date - start) / 86400000) / size)));
      const values = saleTotals(sale);
      buckets[index].revenue += asNumber(values.netRevenue);
      buckets[index].cost += asNumber(values.totalCost);
      buckets[index].profit += asNumber(values.profit);
    });
    return { range, start, end, buckets };
  }
  function chartGrid(maximum, top, bottom, left, right) {
    let out = '';
    for (let index = 0; index <= 4; index++) {
      const y = top + ((bottom - top) * index / 4);
      const value = maximum * (1 - index / 4);
      out += svg('line', { x1: left, y1: y, x2: right, y2: y, stroke: '#29302c', 'stroke-width': 1 });
      out += svg('text', { x: left - 8, y: y + 3, fill: '#7a857e', 'font-size': 10, 'text-anchor': 'end' }, `R$ ${number.format(Math.round(value))}`);
    }
    return out;
  }
  function renderDashboardCharts() {
    const summary = allCalculations();
    const { range, start, end, buckets } = bucketsForPeriod();
    const width = 760, height = 250, left = 58, right = 18, top = 18, bottom = 215, plotWidth = width - left - right;
    const paid = (state.sales || []).filter(item => item.status === 'pago').slice().sort((a, b) => String(a.date).localeCompare(String(b.date)));
    const cumulative = [{ date: localISODate(start), value: 0 }];
    let running = 0;
